# Klucz, którym klienci (Claude Code, pi.dev, inne SDK) autoryzują się do gatewaya.
# Akceptowany zarówno w nagłówku "x-api-key" (klienci Anthropic/Claude Code),
# jak i "Authorization: Bearer <klucz>" (klienci OpenAI-SDK).
GATEWAY_API_KEY=changeme-generate-a-long-random-string

# Klucze API providerów backendowych (używane tylko dla providerów, których faktycznie
# referencjonujesz w config.yaml -> model_list[].deployments[].api_key_env)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
NOVITA_API_KEY=xxxxxxxx
INFRON_API_KEY=xxxxxxxx
NVIDIA_API_KEY=nvapi-xxxxxxxx

# Poziom logowania (tracing / tracing-subscriber, EnvFilter)
RUST_LOG=gateway_llm=info,tower_http=info
